{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Bash(*--backend real*)",
      "Bash(*--backend=real*)",
      "Bash(*--run-robot*)",
      "Bash(git stash*)"
    ],
    "ask": [
      "Bash(*--run-live*)"
    ],
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run go2 catalog*)",
      "Bash(uv run go2 state*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint.sh", "timeout": 120 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint.sh", "timeout": 120 }
        ]
      }
    ]
  }
}
