{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Bash(*--backend real*)",
      "Bash(*--backend=real*)",
      "Bash(*--run-robot*)",
      "Bash(git stash*)"
    ],
    "ask": [
      "Bash(*--run-live*)",
      "Edit(//**/dispatcher/prompts.py)",
      "Write(//**/dispatcher/prompts.py)",
      "Edit(//**/skills/catalog/**/SKILL.md)",
      "Write(//**/skills/catalog/**/SKILL.md)"
    ],
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run basedpyright *)",
      "Bash(uv run lint-imports*)",
      "Bash(uv run go2 catalog*)",
      "Bash(uv run go2 state*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scope.py", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/touched.py", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint.py", "timeout": 120 },
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck.py", "timeout": 120 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint.py", "timeout": 120 },
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck.py", "timeout": 120 }
        ]
      }
    ]
  }
}
